# Copia este archivo como apps/visitor/.env.local y apps/partner/.env y llena los valores.
# Los archivos .env NO se suben a GitHub.

# --- Supabase (Settings > API en el panel de Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Solo para uso del servidor. Nunca en el navegador ni con prefijo NEXT_PUBLIC_ / VITE_
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (Dashboard de Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu-cloud-name
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=zaisanfy_unsigned

# --- Escaparate ---
# URL pública del sitio (en Vercel, la de producción). Se usa en canonical, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Clave para /api/revalidate (ISR on-demand). Inventa una larga; la misma va en el Webhook de Supabase.
REVALIDATE_SECRET=
# URL de la Consola de socios, para el enlace de vendedores y creativos en /entrar
NEXT_PUBLIC_PARTNER_URL=http://localhost:5173

# --- Consola de socios ---
# URL del Escaparate, para los enlaces "Ver en el sitio"
VITE_VISITOR_URL=http://localhost:3000
