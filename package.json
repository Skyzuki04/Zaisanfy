{
  "name": "zaisanfy",
  "private": true,
  "description": "Zaisanfy: plataforma PropTech (monorepo con las 3 apps del SRS)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:visitor": "npm run dev -w apps/visitor",
    "dev:partner": "npm run dev -w apps/partner",
    "dev:admin": "npm run dev -w apps/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test -w packages/schemas"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
